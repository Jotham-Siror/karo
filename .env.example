# Copy to .env and fill in. .env is git-ignored; never paste keys into chat, code or logs.

# Flutterwave, TEST mode only
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
# The "secret hash" you set in the Flutterwave dashboard for webhooks
FLW_WEBHOOK_HASH=

# Anthropic API (console account)
ANTHROPIC_API_KEY=

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Public base URL that Flutterwave and Twilio can reach, e.g. https://karo.example.com
PUBLIC_BASE_URL=

# Karo web app. KARO_PIN_PEPPER, KARO_SESSION_SECRET, KARO_STANDIN_SECRET and KARO_DEMO_PASSWORD must be set.
# Make a secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
KARO_PIN_PEPPER=
KARO_SESSION_SECRET=
KARO_STANDIN_SECRET=
# The password to the demo login, /log and /demo
KARO_DEMO_PASSWORD=
# The main payer's PIN (4 to 6 digits) for the demo family, set when the database is first created
DEMO_PIN=
# Empty means the default: standin
KARO_PROVIDER=
# Empty means the default: data/karo.db (created and seeded on first start)
KARO_DB=
