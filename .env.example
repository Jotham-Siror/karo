# Copy to .env and fill in. .env is git-ignored; never paste keys into chat, code or logs.

# Flutterwave, TEST mode only
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
# The "secret hash" you set in the Flutterwave dashboard for webhooks
FLW_WEBHOOK_HASH=

# Payaza, TEST mode only. Switched off; see README. Used only when KARO_PROVIDER=payaza.
PAYAZA_PUBLIC_KEY=
PAYAZA_SECRET_KEY=

# Anthropic API (console account)
ANTHROPIC_API_KEY=

# Twilio WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number, written as whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Real phones for the demo members, with the country code, e.g. +254712345678. Empty means that member has no WhatsApp.
# Used when the database is first created and on a demo reset. Join the Twilio sandbox from each phone first.
DEMO_WHATSAPP_AMINA=
DEMO_WHATSAPP_BARAKA=
DEMO_WHATSAPP_NAKATO=

# Public base URL that Flutterwave and Twilio can reach, e.g. https://karo.example.com
PUBLIC_BASE_URL=

# Karo web app. KARO_PIN_PEPPER, KARO_SESSION_SECRET, KARO_STANDIN_SECRET and KARO_DEMO_PASSWORD must be set.
# Make a secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
KARO_PIN_PEPPER=
KARO_SESSION_SECRET=
KARO_STANDIN_SECRET=
# The password to the demo login, /log and /demo
KARO_DEMO_PASSWORD=
# The main payer's PIN (4 to 6 digits) for the demo family, set when the database is first created
DEMO_PIN=
# standin (the default) or flutterwave. flutterwave takes payments in Flutterwave test mode and needs FLW_SECRET_KEY
# and FLW_WEBHOOK_HASH. Quotes and payouts stay on the stand-in unless KARO_FLW_PAYOUTS=flutterwave (the test account
# here cannot make transfers).
KARO_PROVIDER=
KARO_FLW_PAYOUTS=
# Empty means the default: data/karo.db (created and seeded on first start)
KARO_DB=
